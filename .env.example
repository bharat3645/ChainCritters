# Used by docker-compose.yml. Copy to .env and adjust as needed; every
# variable has a sane default baked into docker-compose.yml so this file is
# optional for local use.

POSTGRES_USER=chaincritters
POSTGRES_PASSWORD=chaincritters
POSTGRES_DB=chaincritters

# Shared secret Backend/http uses to authenticate its live-update pushes to
# Backend/WebSockets' internal /broadcast endpoint. Change this for anything
# beyond local development.
INTERNAL_API_KEY=dev-internal-key
